rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow connectivity health check ping
    match /users/_ping {
      allow read, write: if true;
    }

    // User accounts, profile, presence, and direct buzz inboxes
    match /users/{username} {
      allow read, write: if true;

      match /inbox/{messageId} {
        allow read, write: if true;
      }
    }

    // 1-on-1 Direct Messaging & Buzzes
    match /conversations/{conversationId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Chatrooms (Philippine Regional & Custom Rooms) and their active chat streams
    match /chatrooms/{roomId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Friend Requests
    match /friend_requests/{requestId} {
      allow read, write: if true;
    }

    // Default fallback for any additional collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
